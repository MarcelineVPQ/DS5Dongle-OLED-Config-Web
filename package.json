{
  "name": "ds5-dongle-configurator",
  "private": true,
  "version": "0.9.5-dev.21",
  "type": "module",
  "scripts": {
    "dev:desktop": "electron-vite dev -- --no-sandbox",
    "build:desktop": "electron-vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start:desktop": "electron-vite preview -- --no-sandbox",
    "gates": "./.hooks/check_electron_security.sh && ./.hooks/check_dom_sinks.sh && node .hooks/check_theme_colors.mjs && node tools/list_duplicates.mjs --check && node tools/check_identical_files.mjs && node tools/list_loops.mjs --check && node tools/list_caches.mjs --check && node tools/list_errors.mjs --check && node tools/list_lifetimes.mjs --check && node tools/list_settings.mjs --check && node tools/list_hints.mjs --check && node tools/doc_gates.mjs --check",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run gates && npm test",
    "dist:linux": "electron-vite build && electron-builder --linux",
    "dist:win": "electron-vite build && electron-builder --win",
    "dist:mac": "electron-vite build && electron-builder --mac"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "i18next": "26.5.11",
    "i18next-browser-languagedetector": "8.2.3",
    "koffi": "3.3.4",
    "lucide-react": "0.577.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-i18next": "17.1.9",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@types/w3c-web-usb": "1.0.14",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.5",
    "electron": "45.2.1",
    "electron-builder": "26.17.0",
    "electron-vite": "5.0.0",
    "eslint": "10.13.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.3",
    "prettier": "3.9.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vite": "7.3.7",
    "vitest": "5.0.5"
  },
  "productName": "DS5 Dongle OLED Edition Configurator",
  "description": "Desktop configurator for the DS5 Dongle OLED Edition firmware.",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT",
  "author": {
    "name": "MarcelineVPQ",
    "email": "noreply@github.com"
  },
  "homepage": "https://github.com/MarcelineVPQ/DS5Dongle-OLED-Config-Web",
  "desktopName": "io.github.MarcelineVPQ.DS5DongleConfigurator.desktop"
}
