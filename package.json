{
  "name": "ds5-dongle-configurator",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "dev:desktop": "electron-vite dev -- --no-sandbox",
    "build:desktop": "electron-vite build",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start:desktop": "electron-vite preview -- --no-sandbox",
    "gates": "./.hooks/check_electron_security.sh && ./.hooks/check_dom_sinks.sh",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run gates && npm test"
  },
  "dependencies": {
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@fontsource/space-grotesk": "5.3.0",
    "i18next": "^26.2.0",
    "i18next-browser-languagedetector": "^8.2.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.8",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/w3c-web-usb": "1.0.14",
    "@vitejs/plugin-react": "5.2.0",
    "@vitest/coverage-v8": "5.0.1",
    "electron": "43.7.5",
    "electron-builder": "26.16.0",
    "electron-vite": "5.0.0",
    "eslint": "10.10.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "typescript": "5.9.3",
    "typescript-eslint": "8.70.1",
    "vite": "7.3.6",
    "vitest": "5.0.1"
  },
  "productName": "DS5 Dongle Configurator",
  "description": "Desktop and web configurator for the DS5 Dongle OLED Edition firmware.",
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22"
  },
  "license": "MIT"
}
