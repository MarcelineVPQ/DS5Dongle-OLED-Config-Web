node_modules/
dist/
.DS_Store
*.log
.vite/

# Firmware artifacts bundled at CI build-time, not committed
public/firmware-latest.uf2
public/firmware-latest.json

# TypeScript incremental build cache (regenerated by tsc; not source)
*.tsbuildinfo
out/
release/

# Firmware bundled by the release workflow (never committed)
resources/firmware/

# Narrator voice: speaker masters and previews are rebuilt from the raw takes
# (tools/master_voice.py); the check report is regenerated by tools/check_voice.py.
assets-src/voice/*-speaker/
assets-src/voice/*-preview.mp3
assets-src/voice/check-report.json
__pycache__/

# Local scratch (dev runs, VM test screenshots)
tmp/

# Source art kept locally only (purchased Zacksly pack, stock photos): not redistributable
assets/
# Agents' git worktrees (whole copies of the repo)
.claude/worktrees/
