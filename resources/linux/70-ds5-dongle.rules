# DS5 Dongle Configurator: "Set up USB access" installs this one rule for
# both uses (one name everywhere in the app):
#  - this app: the board's configurator interface and the RP2350 boot device
#    (firmware updates) over WebUSB;
#  - games: the controller's hidraw node, so Proton / SDL games reach the
#    DualSense directly (adaptive triggers, haptic feedback).
# The board (DualSense / DualSense Edge mode), USB
SUBSYSTEM=="usb", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", TAG+="uaccess"
SUBSYSTEM=="usb", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", TAG+="uaccess"
# RP2350 BOOTSEL (PICOBOOT)
SUBSYSTEM=="usb", ATTRS{idVendor}=="2e8a", ATTRS{idProduct}=="000f", TAG+="uaccess"
# The controller's hidraw node for games (through the board on USB, or a
# DualSense paired to the PC over Bluetooth)
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0ce6", TAG+="uaccess"
KERNEL=="hidraw*", ATTRS{idVendor}=="054c", ATTRS{idProduct}=="0df2", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:0CE6*", TAG+="uaccess"
KERNEL=="hidraw*", KERNELS=="*054C:0DF2*", TAG+="uaccess"
