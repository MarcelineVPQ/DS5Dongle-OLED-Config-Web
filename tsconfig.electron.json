{
  "compilerOptions": {
    "composite": true,
    "target": "ES2022",
    "lib": ["ES2022", "DOM"],
    "types": ["node", "vite/client"],
    "skipLibCheck": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "esModuleInterop": true,
    "isolatedModules": true,
    "noEmit": true,
    "strict": true,
    "noFallthroughCasesInSwitch": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true
  },
  "include": [
    "electron",
    "src/desktop/api.ts",
    "src/errorText.ts",
    "src/i18n/deviceForms.ts",
    "src/i18n/locales/*.json",
    "src/persisted.ts",
    "src/desktop/windowsRepairScript.ts",
    "src/desktop/theme",
    "src/desktop/games",
    "src/update",
    "src/protocol/officialFirmware.ts",
    "src/oled/oledShare.ts",
    "src/oled/oledPixels.ts"
  ]
}
